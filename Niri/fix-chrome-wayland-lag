#!/bin/bash
# Idempotent: configures Chrome/Chromium for smooth Wayland on NVIDIA Optimus.
# - Native Wayland (no XWayland)
# - Disables smooth scrolling (conflicts with Wayland scroll on hybrid GPU)
# Safe to run multiple times.

set -euo pipefail

FLAGSDIR="${HOME}/.config"

mkdir -p "$FLAGSDIR"

echo "==> Writing $FLAGSDIR/chrome-flags.conf"
cat > "$FLAGSDIR/chrome-flags.conf" << 'CHROME'
--ozone-platform-hint=wayland
--ozone-platform=wayland
--disable-features=SmoothScrolling
--disable-gpu-compositing
CHROME

echo "==> Writing $FLAGSDIR/chromium-flags.conf"
cat > "$FLAGSDIR/chromium-flags.conf" << 'CHROMIUM'
--ozone-platform-hint=wayland
--ozone-platform=wayland
--disable-features=SmoothScrolling
--disable-gpu-compositing
CHROMIUM

echo "==> Done. Restart Chrome for changes to take effect."
